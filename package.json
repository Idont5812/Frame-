{
  "name": "frame",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "client": "node node_modules/vite/bin/vite.js --host 0.0.0.0",
    "server": "node --watch server/index.ts",
    "build": "node node_modules/vite/bin/vite.js build",
    "start": "node server/index.ts",
    "typecheck": "node node_modules/typescript/lib/tsc.js -p tsconfig.server.json && node node_modules/svelte-check/bin/svelte-check --tsconfig tsconfig.json",
    "lint": "node node_modules/eslint/bin/eslint.js .",
    "test": "node --test tests/"
  },
  "dependencies": {
    "@lucide/svelte": "^1.74.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^12.4.1",
    "compression": "1.8.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "8.7.4",
    "helmet": "8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "svelte": "^5.57.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/compression": "1.8.1",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/multer": "2.3.0",
    "@types/node": "26.6.6",
    "autoprefixer": "10.6.2",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "postcss": "8.5.33",
    "svelte-check": "^4.7.8",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vite": "^7.1.7"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true
  }
}
